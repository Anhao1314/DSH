# ── 本机工具链（187MB node 二进制，不属于项目源码）
.toolchain/

# ── 上游 deepseek-harness 是独立 clone（含 190MB .git）：整棵排除。
#    我们的 5 个本地 overlay 文件用 ./scripts/track-overlay.sh 单独登记进 index
#    （嵌套 .git 会让 `git add -f` 静默失效）：
#      deepseek-harness/{.dockerignore,.npmrc,Dockerfile.orbstack,orbstack-entrypoint.sh,orbstack-relay.cjs}
deepseek-harness/

# ── 凭据与运行态（绝不入库）
dsh-home/.credentials.yaml
dsh-home/.anonymous-user-id
dsh-home/.pnpm-store/
dsh-home/sessions/
dsh-home/storages/
dsh-home/artifacts/
dsh-home/dump.err
dsh-home/dump.txt
dsh-home/**/*.roster-bak
dsh-home/profiles/**/node_modules/
dsh-home/profiles/**/.dsh-module-fallback/

# ── 挂载点 / 构建产物
workspace/
world-store/
dsh-desktop/build/

